CREATE TABLE LoopLinkUser (
    name TEXT NOT NULL,
    uid TEXT NOT NULL,
    section TEXT,
    program TEXT,
    contact TEXT,
    cGPA TEXT,
    email TEXT,
    pfpPath TEXT
);

CREATE INDEX USERNAME ON LoopLinkUser(name);

insert:
INSERT INTO LoopLinkUser (name, uid) VALUES
(?, ?);

insertAll:
INSERT INTO LoopLinkUser (name, uid, section, program, contact, cGPA, email, pfpPath) VALUES
(?, ?, ?, ? , ?, ?, ?, ?);


selectAll:
SELECT LoopLinkUser.* FROM LoopLinkUser;

delete:
DELETE FROM LoopLinkUser;

getSize:
SELECT COUNT(*) FROM LoopLinkUser;

-- ADD THIS NEW QUERY HERE (from your .sqm file)
updatePfpPath:
UPDATE LoopLinkUser SET pfpPath = ? WHERE uid = ?;

-- ADD THIS NEW QUERY HERE (from your .sqm file)
getPfpPath:
SELECT pfpPath FROM LoopLinkUser LIMIT 1;